<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{${LOG_DATEFORMAT_PATTERN:-dd-MM-yyyy HH:mm:ss.SSS}} :: %highlight{${LOG_LEVEL_PATTERN:-%5p}}{FATAL=red blink, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=green bold, TRACE=blue} %style{${sys:PID}}{magenta} [%15.15t] %style{%-40.40C{1.}}{cyan} :: %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
            <!--            <PatternLayout pattern="%d{HH:mm:ss.SSS}{blue} :: [%t] %-5level %logger{36} :: %msg%n" />-->
        </Console>
        <File name="FileAppender" fileName="/Users/ghislainmuabila/LoggingDemo/gtechFirstSpringBook/WebApp-${date:yyyyMMdd}.log" immediateFlush="false" append="true">
            <PatternLayout pattern="%d{dd-MM-yyyy HH:mm:ss.SSS} :: [%t] %-5level %logger{36} :: %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="ConsoleAppender" />
            <AppenderRef ref="FileAppender"/>
        </Root>
    </Loggers>
</Configuration>
